# Generate your own value: openssl rand -hex 32
# Use the same value in vk_connector_secret (PHP) or VK_CONNECTOR_SECRET (Worker).
FLOW_CONNECTOR_SECRET=
FLOW_MAX_BROWSERS=2
# Optional persistent encrypted session store on the existing PHP hosting.
# Required on ephemeral/free servers; same connector secret on both sides.
FLOW_STATE_URL=https://example.com/flow/api/vk-state.php
